# InvestSphere Web — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# NEVER commit your production .env or actual secret values to version control.

# Application Secret Key for HMAC token signing and session security
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-character-random-hex-string

# Environment Mode: 'production' or 'development'
FLASK_ENV=production

# Database Configuration
# Local SQLite file path or production persistent path
DATABASE_URL=./investsphere_web.db

# Web Server Port
PORT=5000

# Allowed CORS Origins (comma-separated, or * for open)
# In production, restrict to your verified domain (e.g. https://investsphere.onrender.com)
ALLOWED_ORIGINS=https://investsphere.onrender.com,http://localhost:5000,http://127.0.0.1:5000

# Optional Demo Account Defaults (if seed_demo.py is executed)
DEMO_USER_EMAIL=demo@investsphere.demo
DEMO_USER_PASSWORD=DemoInvestor123!

